FROM python:3.12-slim
WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home commerce
COPY app ./app
COPY web ./web
COPY mock_store/catalog.json ./mock_store/catalog.json
COPY mock_store/art ./mock_store/art
USER commerce
ENV COMMERCE_DATABASE_URL=sqlite:////home/commerce/commerce.sqlite3
EXPOSE 8000
CMD ["uvicorn", "app.commerce:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
