FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/srv/backend
COPY requirements.txt ./
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend ./backend
COPY mock_store/art ./mock_store/art
COPY mock_store/catalog.json ./mock_store/catalog.json
RUN useradd --create-home app
USER app
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health',timeout=3)"
CMD ["python","-m","uvicorn","uyaras.main:create_app","--factory","--host","0.0.0.0","--port","8001","--no-access-log"]
